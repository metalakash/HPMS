{
  "name": "hpms-mobile",
  "version": "1.0.0",
  "description": "Hydropower Project Management System - Native Mobile App",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e:build:ios": "detox build-framework-cache && detox build-app-cache --configuration ios.sim.release",
    "e2e:test:ios": "detox test e2e --configuration ios.sim.release --cleanup",
    "e2e:build:android": "detox build-app-cache --configuration android.sim.release",
    "e2e:test:android": "detox test e2e --configuration android.sim.release --cleanup"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-maps": "^1.5.0",
    "react-native-geolocation-service": "^5.3.0",
    "@react-native-camera/camera": "^5.0.0",
    "zustand": "^4.4.0",
    "react-navigation": "^6.1.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-screens": "^3.20.0",
    "react-native-safe-area-context": "^4.5.0",
    "react-native-gesture-handler": "^2.12.0",
    "watermelondb": "^0.28.0",
    "@nozbe/watermelondb": "^0.28.0",
    "i18next": "^23.5.0",
    "react-i18next": "^13.2.0",
    "i18next-react-native-language-detector": "^0.0.1",
    "axios": "^1.5.0",
    "moment": "^2.29.4",
    "react-native-svg": "^13.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.5.0",
    "detox": "^20.0.0",
    "detox-cli": "^20.0.0",
    "eslint": "^8.44.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testEnvironment": "node"
  }
}
