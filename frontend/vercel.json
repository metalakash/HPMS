{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hpms-api.onrender.com/api/:path*" },
    { "source": "/graphql", "destination": "https://hpms-api.onrender.com/graphql" },
    { "source": "/((?!api/|ws/|graphql).*)", "destination": "/index.html" }
  ]
}
