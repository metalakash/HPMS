# Email Service Configuration (Phase 8.3.2)
# Copy to .env and fill in your SMTP credentials

# Email Backend: mock (development) or smtp (production)
EMAIL_BACKEND=mock

# SMTP Configuration (only needed if EMAIL_BACKEND=smtp)
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-16-digit-app-password (generate at https://myaccount.google.com/apppasswords)

# Office365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@company.com
#   SMTP_PASSWORD=your-password

# Custom SMTP server:
#   SMTP_HOST=mail.yourcompany.com
#   SMTP_PORT=587 (or 465 for SSL)
#   SMTP_USER=your-username
#   SMTP_PASSWORD=your-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
EMAIL_FROM=hpms-alerts@hpms.local

# Alert Recipients
# Configure in loan_exposure_sync_schedules.alert_email_addresses
# Example: "risk@bank.com,compliance@bank.com,ops@bank.com"